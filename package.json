{
  "name": "dough-agent-packages",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Source packages for dough agents \u2014 registry agents and app templates, npm-style authoring and publishing.",
  "scripts": {
    "test": "bun test",
    "validate": "bun bin/publish.ts validate agents/*",
