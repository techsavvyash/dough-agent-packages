    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
