{
  "id": "fixer-codex",
  "version": "1.1.0",
  "description": "Addresses review comments on an existing PR via OpenAI Codex (ChatGPT login).",
  "runtime": "codex",
  "model": "gpt-5.5",
  "needsWorkspace": true,
  "workspaceMode": "branch",
  "hooks": [
    { "event": "before-agent", "kind": "setup-workspace" },
    { "event": "before-agent", "kind": "provision-from-config" },
    { "event": "after-agent", "kind": "open-pull-request" },
    { "event": "on-operator-message", "kind": "steer-receive" },
    { "event": "on-turn-completed", "kind": "steer-continuation" }
  ],
  "roles": ["fixer"],
  "keywords": ["github", "review-comments", "pull-request", "codex", "openai"],
  "author": { "name": "techsavvyash", "github": "techsavvyash" },
  "license": "MIT",
  "repository": {
    "repo": "techsavvyash/dough-agent-packages",
    "path": "agents/fixer-codex"
  },
  "promptFile": "./prompt.md",
  "readmeFile": "./README.md"
}
